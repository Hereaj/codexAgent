# Install to /etc/systemd/system/portfolio.service, then:
#   systemctl daemon-reload && systemctl enable --now portfolio
[Unit]
Description=Portfolio FastAPI backend (www.hereaj.com)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/portfolio/backend
ExecStart=/var/www/portfolio/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
